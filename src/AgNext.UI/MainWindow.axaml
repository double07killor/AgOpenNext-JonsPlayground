<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:AgNext.UI.Controls"
        xmlns:local="clr-namespace:AgNext.UI"
        xmlns:vm="clr-namespace:AgNext.UI.ViewModels"
        mc:Ignorable="d"
        x:Class="AgNext.UI.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1280" Height="720"
        Background="#101314"
        Title="AgNext Demo">
    <Window.DataTemplates>
        <DataTemplate x:DataType="vm:MetricModuleViewModel">
            <Border Width="{Binding Width}" Height="{Binding Height}"
                    Canvas.Left="{Binding X}" Canvas.Top="{Binding Y}"
                    Background="#1C2226" CornerRadius="6" BorderBrush="#2E353A" BorderThickness="1"
                    PointerPressed="OnModulePointerPressed"
                    PointerMoved="OnModulePointerMoved"
                    PointerReleased="OnModulePointerReleased">
                <StackPanel Margin="8">
                    <TextBlock Text="{Binding Title}" Foreground="#92A0AB" FontSize="11" />
                    <TextBlock Text="{Binding Value}" Foreground="{Binding Accent}" FontSize="18" />
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:DataType="vm:SectionStatusModuleViewModel">
            <Border Background="#1C2226" CornerRadius="6" Padding="10">
                <StackPanel Spacing="6">
                    <TextBlock Text="{Binding Title}" Foreground="#92A0AB" FontSize="12" />
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:RowStatusViewModel">
                                <Border Background="#151A1D" CornerRadius="6" Padding="8" Margin="0,2,0,0">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Ellipse Width="10" Height="10" Fill="{Binding IsOn, Converter={x:Static local:BooleanToBrushConverter.Instance}}" />
                                        <TextBlock Text="{Binding Index}" Foreground="#C9D3DA" Width="18" />
                                        <TextBlock Text="{Binding Rate, StringFormat={}{0:0}}" Foreground="#8AD1FF" />
                                        <TextBlock Text="L/ha" Foreground="#5E6A74" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:DataType="vm:StatusBarModuleViewModel">
            <TextBlock Text="{Binding Text}" Foreground="#8E9AA6" VerticalAlignment="Center" />
        </DataTemplate>
    </Window.DataTemplates>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#1C1F22" Height="44">
            <DockPanel>
                <TextBlock Text="AgNext Demo" Foreground="#E2E6EA" FontSize="16" Margin="16,0,0,0" VerticalAlignment="Center" />
                <ToggleButton DockPanel.Dock="Right"
                              Width="120" Height="26" Margin="0,0,16,0"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center"
                              IsChecked="{Binding IsUnlocked}">
                    <TextBlock Text="Unlock UI" Foreground="#E2E6EA" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </ToggleButton>
                <ToggleButton DockPanel.Dock="Right"
                              Width="140" Height="26" Margin="0,0,12,0"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center"
                              IsChecked="{Binding IsBoundaryEditMode}">
                    <TextBlock Text="Edit Boundary" Foreground="#E2E6EA" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </ToggleButton>
                <TextBlock DockPanel.Dock="Right" Text="W/S: Speed  A/D: Steer  Space: Auto  Q/E: Swath" Foreground="#8E9AA6" Margin="0,0,12,0" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
        <Grid ColumnDefinitions="*,220" RowDefinitions="*,36" Background="#111517">
            <Border Grid.Column="0" Margin="8" Background="#0C0F10" CornerRadius="8" BorderBrush="#1F2528" BorderThickness="1">
                <Grid>
                    <controls:MapView Snapshot="{Binding Snapshot}"
                                      IsEditMode="{Binding IsBoundaryEditMode}"
                                      BoundaryEdited="OnBoundaryEdited" />
                    <ItemsControl ItemsSource="{Binding OverlayModules}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Grid>
            </Border>

            <StackPanel Grid.Column="1" Margin="8" Spacing="8">
                <ItemsControl ItemsSource="{Binding RightRailModules}" />
            </StackPanel>

            <Border Grid.ColumnSpan="2" Grid.Row="1" Background="#1A1F22" Padding="12,0">
                <ItemsControl ItemsSource="{Binding StatusModules}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </Border>
        </Grid>
    </DockPanel>
</Window>
